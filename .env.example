# AutoOpen — configuração de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — apenas este .env.example vai ao repositório.

# ── Obrigatórias ──────────────────────────────────────────────────
GLPI_URL=https://glpi.suaempresa.com.br      # URL base sem / final
GLPI_TECNICO_LOGIN=tecnico.ti
GLPI_TECNICO_SENHA=sua_senha_aqui

# ── Opcionais (já têm defaults seguros) ──────────────────────────
GLPI_HEADLESS=false        # true = sem janela do browser | false = com janela
GLPI_TIMEOUT=30000         # timeout em ms para operações do Playwright
